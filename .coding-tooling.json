{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "build", "test:unit"],
    "full": ["format:check", "lint", "build", "test:unit", "test:integration"],
    "performance": ["benchmark:smoke"]
  },
  "requiredCapabilities": ["format:check", "lint", "build", "test:unit", "benchmark:smoke"],
  "optionalCapabilities": ["test:integration"],
  "capabilityCommands": {
    ".": {
      "benchmark:smoke": ["bash", "scripts/profile-broad-phase.sh"]
    }
  },
  "merge": {
    "authority": "hosted",
    "requiredChecks": ["rust"]
  }
}
